# Copy to .env for local development. All are optional.

# Where the SQLite database lives. The folder is created if needed.
DATABASE_PATH=data/tendwell.db

# The public address of the site. Required in production for form submissions to work.
# ORIGIN=https://tendwell.example.org

# Port for `node build` (default 3000).
# PORT=3000

# Shown in the footer and at /healthz. CI sets these automatically.
# TENDWELL_VERSION=1.0.0
# BUILD_NUMBER=local
