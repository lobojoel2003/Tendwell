{
	"name": "tendwell",
	"version": "1.0.0",
	"description": "A gentle guide after a death: what to do this week, letters you can download, and a shared plan for the family.",
	"private": true,
	"type": "module",
	"license": "AGPL-3.0-only",
	"author": "Joel Stain Lobo",
	"homepage": "https://github.com/lobojoel2003/Tendwell#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/lobojoel2003/Tendwell.git"
	},
	"bugs": {
		"url": "https://github.com/lobojoel2003/Tendwell/issues"
	},
	"keywords": [
		"bereavement",
		"grief",
		"death",
		"estate",
		"checklist",
		"sveltekit",
		"sqlite"
	],
	"engines": {
		"node": ">=22.17"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node build",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"content:check": "vitest --run --project content",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test",
		"screenshots": "node scripts/screenshots.js",
		"user:reset-password": "node scripts/reset-password.js"
	},
	"dependencies": {
		"better-sqlite3": "^13.1.1",
		"marked": "^18.2.0",
		"pdfkit": "^0.20.2",
		"yaml": "^2.9.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^24",
		"@types/pdfkit": "^0.17.7",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8"
	}
}
